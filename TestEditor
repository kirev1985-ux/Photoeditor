<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>PhotoEditor Fixed</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <style>
        body { margin: 0; background: #000; font-family: sans-serif; overflow: hidden; color: white; touch-action: none; }
        canvas { display: block; background: #111; margin: 0 auto; }
        #gps-live { position: fixed; top: 0; left: 0; width: 100%; background: rgba(0,0,0,0.8); color: #0f0; font-size: 11px; padding: 5px; text-align: center; z-index: 20; }
        #side-menu { position: fixed; right: 10px; top: 50px; display: flex; flex-direction: column; gap: 12px; z-index: 10; }
        .btn-side { width: 52px; height: 52px; background: #333; border: 1px solid #555; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        #bottom-menu { position: fixed; bottom: 30px; width: 100%; display: flex; justify-content: center; align-items: center; gap: 30px; z-index: 10; }
        .btn-cam { width: 80px; height: 80px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40px; color: #000; border: 5px solid #444; }
        #save-screen, #modal-iso { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 1000; }
        .iso-btn { width: 220px; padding: 20px; margin: 10px; border-radius: 15px; font-weight: bold; text-align: center; }
    </style>
</head>
<body>

<div id="gps-live">Ожидание GPS...</div>
<canvas id="canvas"></canvas>

<div id="side-menu">
    <div class="btn-side" onclick="stampGPS()">📍</div>
    <div class="btn-side" onclick="updateNote()">📝</div>
    <div class="btn-side" onclick="showIsoMenu()">💾</div>
</div>

<div id="bottom-menu">
    <div class="btn-side" onclick="undo()" style="position:static">↩️</div>
    <div class="btn-cam" onclick="document.getElementById('hiddenInput').click()">📷</div>
    <div class="btn-side" onclick="location.reload()" style="position:static">🔄</div>
</div>

<div id="modal-iso">
    <div class="iso-btn" style="background: #600; border: 2px solid red;" onclick="finalizeSave('КРАСНАЯ ИЗО', 'red')">КРАСНАЯ ИЗО</div>
    <div class="iso-btn" style="background: #660; border: 2px solid yellow;" onclick="finalizeSave('ЖЕЛТАЯ ИЗО', 'yellow')">ЖЕЛТАЯ ИЗО</div>
    <div style="margin-top: 20px;" onclick="document.getElementById('modal-iso').style.display='none'">ОТМЕНА</div>
</div>

<input type="file" id="hiddenInput" accept="image/*" capture="environment" style="display:none" onchange="loadPhoto(this)">

<div id="save-screen" onclick="this.style.display='none'">
    <p>ЗАЖМИ ДЛЯ СОХРАНЕНИЯ</p>
    <img id="save-img" style="max-width: 90%; max-height: 80%; border: 1px solid white;">
</div>

<script>
    const canvas = document.getElementById('canvas'), ctx = canvas.getContext('2d');
    let history = [], currentNote = "", lastGPS = { lat: 0, lon: 0, acc: 0 }, baseImage = null;
    let drawing = false, lastX = 0, lastY = 0;

    window.onload = () => {
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        ctx.fillStyle = '#111'; ctx.fillRect(0, 0, canvas.width, canvas.height);
        navigator.geolocation.watchPosition(p => {
            lastGPS = { lat: p.coords.latitude, lon: p.coords.longitude, acc: p.coords.accuracy };
            document.getElementById('gps-live').innerText = `GPS: ${lastGPS.lat.toFixed(6)}, ${lastGPS.lon.toFixed(6)} (±${lastGPS.acc.toFixed(1)}м)`;
        }, null, { enableHighAccuracy: true });
    };

    function loadPhoto(input) {
        if (!input.files[0]) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            const img = new Image();
            img.onload = () => { baseImage = img; render(); };
            img.src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
    }

    function wrapText(text, maxWidth) {
        const words = text.split(' '), lines = []; let line = '';
        for (let n = 0; n < words.length; n++) {
            let test = line + words[n] + ' ';
            if (ctx.measureText(test).width > maxWidth && n > 0) { lines.push(line); line = words[n] + ' '; }
            else { line = test; }
        }
        lines.push(line); return lines;
    }

    function render() {
        if (!baseImage) return;
        const ratio = Math.min(canvas.width / baseImage.width, canvas.height / baseImage.height);
        const w = baseImage.width * ratio, h = baseImage.height * ratio;
        ctx.clearRect(0,0, canvas.width, canvas.height);
        ctx.fillStyle = "#000"; ctx.fillRect(0,0, canvas.width, canvas.height);
        ctx.drawImage(baseImage, (canvas.width - w)/2, (canvas.height - h)/2, w, h);
        
        if (currentNote) {
            ctx.font = "16px Arial";
            const lines = wrapText(currentNote, canvas.width - 40);
            const boxH = lines.length * 22 + 10;
            ctx.fillStyle = "rgba(0,0,0,0.6)"; 
            ctx.fillRect(0, canvas.height - 40 - boxH, canvas.width, boxH);
            ctx.fillStyle = "white"; ctx.textAlign = "center";
            lines.forEach((l, i) => ctx.fillText(l, canvas.width/2, (canvas.height - 35 - boxH) + 20 + (i*22)));
        }
        saveStep();
    }

    canvas.addEventListener('touchstart', e => { 
        drawing = true; lastX = e.touches[0].clientX; lastY = e.touches[0].clientY; 
        ctx.beginPath(); ctx.moveTo(lastX, lastY);
    });
    canvas.addEventListener('touchmove', e => {
        if (!drawing) return; e.preventDefault();
        const tx = e.touches[0].clientX, ty = e.touches[0].clientY;
        ctx.strokeStyle = "red"; ctx.lineWidth = 4; ctx.lineCap = "round";
        ctx.lineTo(tx, ty); ctx.stroke();
    });
    canvas.addEventListener('touchend', () => { drawing = false; saveStep(); });

    function stampGPS() {
        const txt = `📍 ${lastGPS.lat.toFixed(6)}, ${lastGPS.lon.toFixed(6)} (±${lastGPS.acc.toFixed(1)}м)`;
        ctx.fillStyle = "rgba(0,0,0,0.8)"; ctx.fillRect(0, canvas.height - 40, canvas.width, 40);
        ctx.fillStyle = "white"; ctx.font = "bold 16px Arial"; ctx.textAlign = "center";
        ctx.fillText(txt, canvas.width/2, canvas.height - 15);
        saveStep();
    }

    function updateNote() {
        const n = prompt("Описание:", currentNote);
        if (n !== null) { currentNote = n; render(); }
    }

    function showIsoMenu() { document.getElementById('modal-iso').style.display = 'flex'; }

    function finalizeSave(label, color) {
        ctx.fillStyle = "rgba(0,0,0,0.8)"; ctx.fillRect(10, 45, 160, 35);
        ctx.strokeStyle = color; ctx.lineWidth = 3; ctx.strokeRect(10, 45, 160, 35);
        ctx.fillStyle = color; ctx.font = "bold 14px Arial"; ctx.textAlign = "center";
        ctx.fillText(label, 90, 68);
        document.getElementById('modal-iso').style.display = 'none';
        document.getElementById('save-img').src = canvas.toDataURL("image/png");
        document.getElementById('save-screen').style.display = 'flex';
    }

    function saveStep() { history.push(canvas.toDataURL()); if(history.length > 15) history.shift(); }
    function undo() {
        if(history.length > 1) {
            history.pop(); const i = new Image();
            i.onload = () => { ctx.clearRect(0,0,canvas.width,canvas.height); ctx.drawImage(i,0,0); };
            i.src = history[history.length-1];
        }
    }
</script>
</body>
</html>
